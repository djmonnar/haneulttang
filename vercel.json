      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "^haneulttang\\.vercel\\.app$"
        }
      ],
      "destination": "https://xn--wh1bu4c029b.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "^haneulttang\\.vercel\\.app$"
        }
      ],
      "destination": "https://xn--wh1bu4c029b.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "^www\\.xn--wh1bu4c029b\\.com$"
        }
      ],
      "destination": "https://xn--wh1bu4c029b.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
